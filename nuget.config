<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org: the machine-wide config may list company feeds that are not always reachable. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
